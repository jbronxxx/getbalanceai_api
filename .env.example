# Application Configuration
APP_DEBUG=true # Для разработки; на production — false (тогда обязательны стойкий SECRET_KEY и OAuth client ID)
LOG_LEVEL=INFO  # Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
APP_HOST=0.0.0.0
APP_PORT=8000
# Интерфейс хоста, на котором Docker публикует порт API: 127.0.0.1 — только локально (прод, по умолчанию),
# 0.0.0.0 — для доступа из локальной сети, например с телефона при разработке. На проде не менять
APP_BIND=127.0.0.1

# PostgreSQL Database Credentials
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_pass
POSTGRES_DB=get_balance_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Database URL
# Для Docker используйте хост 'db': postgresql://db_user:db_pass@db:5432/get_balance_db
# Для локального запуска используйте хост 'localhost': postgresql://db_user:db_pass@localhost:5432/get_balance_db
DATABASE_URL=postgresql://db_user:db_pass@db:5432/get_balance_db
# Настройки пула соединений БД (опционально)
# DB_POOL_SIZE=5        # на воркер; 4 воркера × (5 + 10) должны оставаться ниже max_connections Postgres (100)
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true

# Redis Configuration
# Для Docker используйте хост 'redis': redis://redis:6379/0
# Для локального запуска: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
# Хранилище счётчиков rate limiting (по умолчанию memory:// — отдельный счётчик в каждом воркере).
# В docker-compose задаётся Redis, чтобы лимит был общим для всех воркеров gunicorn
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# Security and JWT
# Сгенерируйте секретный ключ, например: openssl rand -hex 32
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API (Optional)
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT_PER_USER=5
# AI_REQUEST_TIMEOUT=30  # секунды ожидания ответа Gemini, дальше state=busy

# Grafana Admin Credentials (пароль обязателен; на проде — стойкий, применяется только при первом создании тома grafana_data)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# OAuth (Google & Apple)
# Client ID приложений через запятую (Android, iOS, Web): токен принимается, только если его aud совпадает с одним из них.
# GOOGLE_CLIENT_ID обязателен при APP_DEBUG=false (обычно Web client ID — его получает и Android-клиент).
# APPLE_CLIENT_ID необязателен: пока он пуст, вход через Apple отклоняется. Значение — Bundle ID iOS-приложения (и Services ID для веба)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Currency Exchange Rates Gateway (Optional)
CURRENCY_RATES_URL=https://open.er-api.com/v6/latest/USD
CURRENCY_RATES_CACHE_TTL=86400 # Время жизни кэша котировок валют в секундах (по умолчанию 86400 = 24 часа)
CURRENCY_RATES_FALLBACK_CACHE_TTL=180 # Время жизни негативного кэша при сбое шлюза в секундах (по умолчанию 180 = 3 минуты)
CURRENCY_RATES_TIMEOUT=4.0 # Таймаут запроса к шлюзу котировок в секундах (по умолчанию 4.0)
CLIENT_RATE_TOLERANCE_PERCENT=15.0 # Допустимое отклонение клиентского курса валют в процентах (по умолчанию 15%)

# CORS Settings (Optional)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# CORS_ALLOW_CREDENTIALS=false  # при APP_DEBUG=false нельзя true вместе с CORS_ORIGINS=*
